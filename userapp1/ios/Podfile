platform :ios, '16.0'
use_frameworks! :linkage => :static
use_modular_headers!

require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/react-native-permissions/scripts/setup'
prepare_react_native_project!

$RNFirebaseAsStaticFramework = true

target 'userapp1' do
  use_react_native!(
    :path => '../node_modules/react-native',
    :hermes_enabled => false,
    :fabric_enabled => false,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Extra pods
  pod 'react-native-image-picker',
      path: '../node_modules/react-native-image-picker'

  pod 'RNCPushNotificationIOS',
      path: '../node_modules/@react-native-community/push-notification-ios'

  # Firebase
  pod 'RNFBApp', :path => '../node_modules/@react-native-firebase/app'
  pod 'RNFBAuth', :path => '../node_modules/@react-native-firebase/auth'
  pod 'RNFBMessaging', :path => '../node_modules/@react-native-firebase/messaging'

  # React Navigation dependencies
  pod 'RNScreens', :path => '../node_modules/react-native-screens'
  pod 'react-native-safe-area-context', :path => '../node_modules/react-native-safe-area-context'

  # Other dependencies
  pod 'lottie-react-native', :path => '../node_modules/lottie-react-native'
  pod 'RNCPicker', :path => '../node_modules/@react-native-picker/picker'
  pod 'react-native-encrypted-storage', :path => '../node_modules/react-native-encrypted-storage'
  pod 'CodePush', :path => '../node_modules/react-native-code-push'

  # React-Native-Permissions — only subspecs you need.
  # ⬇︎ This automatically pulls the umbrella RNPermissions pod.
  setup_permissions(%w[
    LocationWhenInUse
    LocationAlways
    Notifications
    Contacts
    PhotoLibrary
    Camera
  ])

  target 'userapp1Tests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      '../node_modules/react-native',
      :mac_catalyst_enabled => false
    )

    # ❌ DO NOT delete the RNPermissions target any more!
    installer.pods_project.targets.each do |tgt|
      tgt.build_configurations.each do |cfg|
        cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
        cfg.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        cfg.build_settings['CLANG_CXX_LIBRARY_STANDARD']  = 'libc++'
      end
    end
  end
end
